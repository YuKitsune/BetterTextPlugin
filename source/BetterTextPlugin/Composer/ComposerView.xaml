<UserControl
    x:Class="BetterTextPlugin.Composer.ComposerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:BetterTextPlugin"
    xmlns:controls="clr-namespace:BetterTextPlugin.Controls"
    Loaded="OnLoaded"
    MouseLeave="OnMouseLeave">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BetterTextPlugin;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{x:Static local:Theme.BackgroundColor}">
        <controls:BeveledBorder BevelType="Raised" BorderThickness="{x:Static local:Theme.BeveledBorderThickness}">
            <StackPanel Width="320" Margin="4">

                <!-- Inbox: hidden when no messages -->
                <StackPanel x:Name="InboxSection" Visibility="Collapsed">
                    <ScrollViewer
                        MaxHeight="80"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding InboxMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Text="{Binding Display}"
                                        Style="{StaticResource GenericTextStyle}"
                                        Padding="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Rectangle Height="1" Margin="0,3,0,2" Fill="{x:Static local:Theme.GenericTextColor}"/>
                </StackPanel>

                <!-- Buffer: hidden when empty -->
                <StackPanel x:Name="BufferSection" Visibility="Collapsed">
                    <ItemsControl ItemsSource="{Binding Buffer}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding}"
                                    Style="{StaticResource GenericTextStyle}"
                                    TextWrapping="Wrap"
                                    Padding="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Rectangle Height="1" Margin="0,3,0,2" Fill="{x:Static local:Theme.GenericTextColor}"/>
                </StackPanel>

                <!-- Search panel -->
                <StackPanel x:Name="SearchPanel">
                    <TextBox
                        x:Name="SearchBox"
                        Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,0,2"/>
                    <ListBox
                        x:Name="ResultsList"
                        ItemsSource="{Binding SearchResults}"
                        SelectedIndex="{Binding HighlightedIndex, Mode=TwoWay}"
                        MaxHeight="200"
                        Focusable="False">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="Transparent" Padding="0,1">
                                                <TextBlock
                                                    Text="{Binding DisplayText}"
                                                    Style="{StaticResource InteractiveTextStyle}"
                                                    TextWrapping="Wrap"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{x:Static local:Theme.DarkBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>

                <!-- Edit panel: DataContext switches to EditingViewModel -->
                <StackPanel x:Name="EditPanel" DataContext="{Binding Editing}" Visibility="Collapsed">
                    <TextBlock
                        Text="{Binding Text}"
                        Style="{StaticResource GenericTextStyle}"
                        TextWrapping="Wrap"
                        Padding="0,1"
                        Margin="0,0,0,4"/>
                    <DockPanel>
                        <TextBlock
                            DockPanel.Dock="Left"
                            Text="{Binding CurrentParamName}"
                            Style="{StaticResource GenericTextStyle}"
                            Margin="0,0,6,0"/>
                        <TextBox
                            x:Name="ParamInput"
                            Text="{Binding CurrentParamValue, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </StackPanel>

            </StackPanel>
        </controls:BeveledBorder>
    </Border>

</UserControl>
